# LocaTrack Environment Variables
# Copy this file to .env and fill in your values

# Supabase Configuration
# Get these from your Supabase project dashboard: Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Optional: Supabase Project ID (for reference)
VITE_SUPABASE_PROJECT_ID=your-project-id

# Skylinesport app API (NestJS backend) — used by /reset-password to confirm
# password resets. Set to the deployed backend URL (e.g. the Railway URL).
VITE_API_URL=https://api.skylinesport.in
